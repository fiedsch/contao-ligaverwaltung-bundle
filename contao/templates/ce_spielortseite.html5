<?php $this->extend('block_searchable'); ?>

<?php $this->block('content'); ?>

<div class="row mt-3">
  <div class="spielortinfo col-sm-12">
      <?= $this->spielortinfo; ?>
  </div>
</div>


<div class="row  mt-3">
  <div class="mannschaften col-sm-12">
      <?php foreach (array_keys($this->mannschaften) as $ligaId): ?>
          <h2><?= $this->mannschaften[$ligaId][0]['liga'] ?> <?= $this->mannschaften[$ligaId][0]['saison'] ?></h2>
          <ul>
              <?php foreach ($this->mannschaften[$ligaId] as $mannschaft): ?>
                  <li>
                      <?= $mannschaft['link'] ?>
                  </li>
              <?php endforeach ?>
          </ul>
      <?php endforeach ?>

  </div>
</div>

<?php $this->endblock(); ?>

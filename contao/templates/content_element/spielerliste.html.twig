{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}

    {% if as_editor_view %}

        {% block editor_view %}
            <div class="tl_gray">
                <span class="upper">{{ wildcard }}</span>
                <br>
                {{ subject }}
            </div>
        {% endblock %}

    {% else %}

        {% set placeholderImage = placeholderImage|default('files/assets/site/images/Darts_Logo.svg') %}
        {% set avatarWidth = avatarWidth|default('100px') %}

        {% if listitems %}
            <div class="table-responsive">
                <table class="table table-hover table-condensed">
                    <tbody>
                    <thead>
                    <tr>
                        {%  block playernameheader %}<th>Name</th>{% endblock %}
                        {%  block playerpassheader %}<th>Spieler&shy;pass</th>{% endblock %}
                        {%  block playerpositionheader %}<th></th>{% endblock %}
                        {% if showdetails %}
                            {% block playerdetailsheader %}<th>Kontakt</th>{% endblock %}
                        {% endif %}
                        {% block playeravatarheader %}<th><!-- Bild --></th>{% endblock %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for listitem in listitems %}
                        <tr>
                            {% block playername %}<td>{% if listitem.member.anonymize %}***{%  else %}{{ listitem.member.firstname }} {{ listitem.member.lastname }}{% endif %}</td>{% endblock %}
                            {% block playerpass %}<td>{% if listitem.member.anonymize %}***{%  else %}{{ listitem.member.passnummer }}{% endif %}</td>{% endblock %}
                            {% block playerposition %}<td>{{ listitem.position|default('-') }}</td>{% endblock %}
                            {% if showdetails %}
                                {% block playerdetails %}<td>{% if listitem.member.anonymize %}***{%  else %}{{ listitem.meta|raw }}{% endif %}</td>{% endblock %}
                            {% endif %}
                            {% block playeravatar %}
                            <td>
                                {% if listitem.avatar and not listitem.member.anonymize %}
                                    <figure class="image_container float_above" style="margin-right:1em;" itemscope="" itemtype="https://schema.org/ImageObject" itemprop="associatedMedia">
                                        <a href="{{ listitem.avatar }}" data-lightbox="lb1" itemprop="contentUrl" class="cboxElement">
                                            <img src="{{ listitem.avatar }}" class="img-thumbnail my-anywidth" width="{{ avatarWidth }}" alt="" itemprop="image">
                                        </a>
                                    </figure>
                                {% else %}
                                    {# kein Bild vorhanden oder anonymisieren! #}
                                    <img src="{{ placeholderImage }}" class="img-thumbnail my-anywidth" width="{{ avatarWidth }}" alt="... Name ... TODO" itemprop="image">
                                {% endif %}
                            </td>
                            {% endblock %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block css %}
<style>
    .my-anywidth {
        /* unset max-width of Bootstrap's .thumbnail */
        max-width: initial !important;
    }
</style>
{% endblock %}

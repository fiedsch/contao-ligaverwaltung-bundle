{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}

    {% if as_editor_view %}

        {% block editor_view %}
            <div class="tl_gray">
                <span class="upper">{{ wildcard }}</span>
                <br>
                {{ subject }}
            </div>
        {% endblock %}

    {% else %}

        {% if listitems|default is empty %}
            {% block no_results_yet %}
                <code>Es liegen noch keine Ergebnisse vor.</code>
            {% endblock %}

        {% else %}

            {% set subtype = '' %}
            {% if rankingtype == constant('Fiedsch\\Ligaverwaltung\\Controller\\ContentElement\\RankingController::RANKING_TYPE_S_MANNSCHAFTEN') %}
                {% set subtype = 'mannschaften' %}
            {% endif %}
            {% if rankingtype == constant('Fiedsch\\Ligaverwaltung\\Controller\\ContentElement\\RankingController::RANKING_TYPE_S_SPIELER') %}
                {% set subtype = 'spieler' %}
            {% endif %}
            {% block subtemplate %}
                {% set subtemplate = subtemplate|default('@Contao/content_element/ranking_' ~ subtype ~ '.html.twig') %}
                {% include subtemplate %}
            {% endblock %}

        {% endif %}

    {% endif %}

{% endblock %}

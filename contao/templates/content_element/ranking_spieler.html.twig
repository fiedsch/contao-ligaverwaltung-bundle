<div class="table-responsive">
    <table class="table table-hover">
        <thead>
        {% block resultsheader %}
            <tr>
                <th>Platz</th>
                <th>Name</th>
                {% if rankingsubtype == 'alle' %}
                    <th>Mannschaft</th>
                {% endif %}
                <th>Legs</th>
                <th>Spiele</th>
                {% if ranking_model != constant('Fiedsch\\Ligaverwaltung\\Helper\\RankingHelper::RANKING_MODEL_TOTAL_ONLY') %}
                    <th>Punkte</th>
                {% endif %}
            </tr>
        {% endblock %}
        </thead>
        <tbody>
        {% for listitem in listitems %}
            {% block resultsrow %}
                <tr class="{{ listitem['CSS'] }}">
                    {% block rang %}
                        <td>{{ listitem['rang'] }}</td>{% endblock %}
                    {% block name %}
                        <td>{{ listitem['name'] }}</td>{% endblock %}
                    {% if rankingsubtype == 'alle' %}
                        {% block mannschaft %}
                            <td>{{ listitem['linkedmannschaft'] |raw }}</td>{% endblock %}
                    {% endif %}
                    {% block legs %}
                        <td>{{ listitem['legs_self'] }} : {{ listitem['legs_other'] }}</td>{% endblock %}
                    {% block spiele %}
                        <td>{{ listitem['spiele_self'] }} : {{ listitem['spiele_other'] }}</td>{% endblock %}
                    {% if ranking_model != constant('Fiedsch\\Ligaverwaltung\\Helper\\RankingHelper::RANKING_MODEL_TOTAL_ONLY') %}
                        {% block punkte %}
                            <td>{{ listitem['punkte_self'] }}</td>{% endblock %}
                    {% endif %}
                </tr>
            {% endblock %}
        {% endfor %}
        </tbody>
    </table>
</div>

{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}

  {% if as_editor_view %}

     {% block editor_view %}
         <div class="tl_gray">
             <span class="upper">{{ wildcard }}</span>
             <br>
             {{ subject }}
         </div>
      {% endblock %}

  {% else %}

      {% for id,liga in ligen %}
          <div class="table-responsive">
              <h3>{{ liga }}</h3>
              <table class="table table-hover">
                  <thead>
                  <tr>
                      <th>Mannschaft</th>
                      <th>Teamcaptain</th>
                      <th>Spielort</th>
                  </tr>
                  </thead>
                  <tbody>
                  {%  for mannschaft in ligendetails[id] %}
                      <tr>
                          <td>{{ mannschaft.mannschaft|raw }}</td>
                          <td>{{ mannschaft.tc[0].name|default }} {{ mannschaft.tc[0].email|default|raw }} {{ mannschaft.tc[0].mobile|default|raw }}</td>
                          <td>{{ mannschaft.spielort.name }}
                              {% if mannschaft.spielort.phone %}
                                  <br><a href="tel:{{ mannschaft.spielort.phone }}">{{ mannschaft.spielort.phone }}</a>
                              {% endif %}
                              {% if mannschaft.spielort.website %}
                                  <br><a href="{{ mannschaft.spielort.website }}">{{ mannschaft.spielort.website }}</a>
                              {% endif %}
                          </td>
                      </tr>
                  {% endfor %}
                  </tbody>
              </table>
          </div>
      {% endfor %}

  {% endif %}

{% endblock %}

{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}

  {% if as_editor_view %}

     {% block editor_view %}
         <div class="tl_gray">
             <span class="upper">{{ wildcard }}</span>
             <br>
             {{ subject }}
         </div>
      {% endblock %}

  {% else %}
      {%  block headline %}
          <div class="row">
              <div class="col-sm-12">
                  <h1>Mannschaftsseite {{ mannschaft_name  }} {{ liga }} {{ saison }}</h1>
              </div>
          </div>
      {% endblock %}

      {%  block spielortinfo %}
          <div class="row mt-3">
              <div class="spielortinfo col-md-6 col-sm-12">
                  {{ spielortinfo|raw }}
              </div>
          </div>
      {% endblock %}

      {%  block spielerliste %}
          <div class="row mt-3">
              <div class="spielerliste col-sm-12">
                  {{ spielerliste|raw }}
              </div>
          </div>
      {% endblock %}

      {% block spielplan %}
          <div class="row mt-3">
              <div class="spielplan col-sm-12">
                  {{ spielplan|raw }}
              </div>
          </div>
      {% endblock %}

      {% block ranking %}
          <div class="row mt-3">
              {%  block ranking_spieler %}
                  <div class="ranking col-md-6 col-sm-12">
                      {{ ranking|raw }}
                  </div>
              {% endblock %}
              {% block ranking_highlights %}
                  <div class="ranking col-md-6 col-sm-12">
                      {{ highlightranking|raw }}
                  </div>
              {% endblock %}
          </div>
      {% endblock %}

  {% endif %}

{% endblock %}

{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}

  {% if as_editor_view %}

     {% block editor_view %}
         <div class="tl_gray">
             <span class="upper">{{ wildcard }}</span>
             <br>
             {{ subject }}
         </div>
      {% endblock %}

  {% else %}

      <h1>{{ begegnunglabel }}</h1>

      {% if spielergebnisse %}
          <h2>Spiele</h2>
          <div class="table-responsive">
              <table class="table table-hover">
                  <thead>
                  <tr>
                      <th>{{ home }}</th>
                      <th>{{ away }}</th>
                      <th></th>
                  </tr>
                  </thead>
                  <tbody>
                  {% for spielergebnis in spielergebnisse %}
                  <tr>
                      <td>{{ spielergebnis.home|raw }}</td>
                      <td>{{ spielergebnis.away|raw }}</td>
                      <td>{{ spielergebnis.score|raw }}</td>
                  </tr>
                  {% endfor %}
                  </tbody>
              </table>
          </div>
      {% endif %}

    {% if highlights %}
        <h2>Highlights</h2>

<div class="table-responsive">
<table class="table table-hover">
    <thead>
    <tr>
        <th>Spieler</th>
        <th>Team</th>
        <th>180</th>
        <th>171</th>
        <th>Shortleg</th>
        <th>Highfinish</th>
    </tr>
    </thead>
    <tbody>
    {% for data in highlights %}
        <tr>
            <td>{{ data.name }}</td>
            <td>{{ data.team }}</td>
            <td>{{ data.highlights[1] }}</td>
            <td>{{ data.highlights[2] }}</td>
            <td>{{ data.highlights[3] }}</td>
            <td>{{ data.highlights[4] }}</td>
        </tr>
    {% endfor %}
</tbody>
</table>
</div>
    {% endif %}



  {% endif %}

{% endblock %}

{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}

  {% if as_editor_view %}

      {% block editor_view %}
          <div class="tl_gray">
              <span class="upper">{{ wildcard }}</span>
              <br>
              {{ details }}
          </div>
      {% endblock %}

  {% else %}

      {% if spiele is empty %}
          {% block no_games_yet %}
              <code>Es sind noch keine Spiele hinterlegt.</code>
          {% endblock %}
      {% else %}


          {% set iCalHref = ical_link %}
          {% set icalName = calendarBaseName ~ "-liga-" ~ ligaId %}
          {% if mannschaftId > 0 %}
              {% set icalName = icalName ~ "-mannschaft-" ~ mannschaftId  %}
          {% endif %}
          {% set icalName =icalName ~ '.ics' %}

          {% block ical_link %}
              <div class="icaldownload">
                  <i class="fas fa-calendar"></i>
                  <a href="{{ iCalHref }}" download="{{ icalName }}">{% block ical_link_text %}Kalender-Import (Download als iCal){% endblock %}</a>
              </div>
          {% endblock %}

          {% if mannschaftId > 0 %} {# nur ein langer Block #}
              <div class="table-responsive">
              <table class="spielplan table table-hover">
              <tbody>
          {% endif %}

          {%  for spieltag,spieltagspiele in spiele %}
              {% if mannschaftId > 0 %}
                  {# keine Zwischenüberschriften bei "Spielplan einer Mannschaft"  #}
              {% else %}
                  {# Ausgabe auf einer Liga-Seite #}
                  {#  TODO sublevel wie im "alten CE" #}<h{{ subheadlineUnit|default(3) }}>{{ spieltag }}. Spieltag</h{{ subheadlineUnit|default(3) }}>
                  <div class="table-responsive">
                  <table class="spielplan table table-hover"> {# ein Inhalts-Block (eine Taballe) je Spieltag  #}
                  <tbody>
              {% endif %}
              {% for spiel in spieltagspiele %}
                  {% block spiel %}
                      <tr>
                          {% block datum %}
                              <td class='spiel am w-25'>
                                  {% if mannschaftId > 0 %}
                                      {{ spiel.spiel_tag }}. Spieltag:
                                  {% endif %}
                                  {% if spiel.spielfrei %}
                                      Spielfrei
                                  {% else %}
                                      {% if spiel.postponed %}
                                          Verschoben
                                      {% else %}
                                          {{ spiel.am }} {{ spiel.um|default }}
                                      {% endif %}
                                  {% endif %}
                              </td>
                          {% endblock %}
                          {% if mannschaftId > 0 %}
                              {% block played_home_away_icon %}
                                  <td class="spiel where">
                                      {% if spiel.heimspiel %}
                                          {%  block home_icon %}
                                              H{#  Home #}
                                          {%  endblock %}
                                      {% else %}
                                          {%  block away_icon %}
                                              A{# Away #}
                                          {% endblock %}
                                      {% endif %}
                                  </td>
                              {% endblock %}
                          {% endif %}
                          {% block team_home %}
                              <td class='spiel home w-25'>
                                  {% if spiel.home.active %}
                                      {% if spiel.home.link %}
                                          <a href="{{ spiel.home.link }}">{{ spiel.home.name }}</a>
                                      {% else %}
                                          {{ spiel.home.name }}
                                      {% endif %}
                                  {% else %}
                                      <s>{{ spiel.home.name }}</s> (nicht mehr aktiv)
                                  {% endif %}
                              </td>
                          {% endblock %}
                          {% block team_away %}
                              <td class='spiel away w-25'>
                                  {% if spiel.away.active %}
                                      {% if spiel.away.link %}
                                          <a href="{{ spiel.away.link }}">{{ spiel.away.name }}</a>
                                      {% else %}
                                          {{ spiel.away.name }}
                                      {% endif %}
                                  {% else %}
                                      <s>{{ spiel.away.name }}</s> (nicht mehr aktiv)
                                  {% endif %}
                              </td>
                          {% endblock %}
                          {% block played_venue %}
                              <td class='spiel ort w-25'>
                                  {% if spiel.spielortlink %}
                                      <a href="{{ spiel.spielortlink }}">{{ spiel.spielort }}</a>
                                  {% else %}
                                      {{ spiel.spielort }}
                                  {% endif %}
                              </td>
                          {% endblock %}
                          {% block score %}
                              {% if spiel.counted %}
                                  <td class='spiel score'>
                                      {% if spiel.score_link %}
                                      <a href="{{ spiel.score_link }}">{{ spiel.home.score }}:{{ spiel.away.score }}</a>
                                      {% else %}
                                          {{ spiel.home.score }}:{{ spiel.away.score }}
                                      {% endif %}
                                  </td>
                                  <td class='spiel legs'>
                                      {% if spiel.home.noshow %}
                                          Heim nicht angetreten
                                      {% elseif spiel.away.noshow %}
                                          Gast nicht angetreten
                                      {% else %}
                                        {{ spiel.home.legs }}:{{ spiel.away.legs }}
                                      {% endif %}
                                  </td>
                              {% else %}
                                  <td colspan="2" class="empty-score">
                                      {% if spiel.played and not spiel.counted %}
                                          nicht gewertet
                                      {% endif %}
                                      {% if not spiel.played and (not spiel.home.active or not spiel.away.active) %}
                                          entfällt
                                      {% endif %}
                                  </td>
                              {% endif %}
                          {% endblock %}
                      </tr>
                      {# <tr><td colspan="8">{{ spiel|json_encode }}</td></tr> #}
                  {% endblock %}
              {% endfor %}
              {% if mannschaftId > 0 %}
              {% else %}
                  </tbody>
                  </table>
                  </div>
              {% endif %}
          {% endfor %}

          {% if mannschaftId > 0 %}
              </tbody>
              </table>
              </div>
          {% endif %}

      {% endif %}
  {% endif %}

{% block style %}
<style>
    .spiel.legs {
        color: #999;
    }
</style>
{% endblock %}

{% endblock %}

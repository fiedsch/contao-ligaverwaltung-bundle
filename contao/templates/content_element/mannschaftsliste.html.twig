{% extends "@Contao/content_element/_base.html.twig" %}
{% use '@Contao/component/_list.html.twig' %}

{% block content %}

  {% if as_editor_view %}

     {% block editor_view %}
         <div class="tl_gray">
             <span class="upper">{{ wildcard }}</span>
             <br>
             {{ subject }}
         </div>
      {% endblock %}

  {% else %}

      {% with { items: listitems } %}{{ block('list_component') }}{% endwith %}
      {% block list_item %}
          {% if item|default is not empty %}
              {% if item.url %}
                  <a href="{{ item.url }}">{{ item.name }}</a>
              {% else %}
                  {{ item.name }}
              {% endif %}
          {% endif %}
      {% endblock %}

  {% endif %}

{% endblock %}

{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}

  {% if as_editor_view %}

     {% block editor_view %}
         <div class="tl_gray">
             <span class="upper">{{ wildcard }}</span>
             <br>
             {{ subject }}
         </div>
      {% endblock %}

  {% else %}

      {% if listitems %}
          {%  block listitems %}
          <ul>
          {% for item in listitems %}
              {%  block listitem %}
                  {%  block listitem_liga %}<li>{{ item['liga'] }}</li>{% endblock %}
                  {%  block listitem_mannschaften %}
                      <ul>
                          {% for subitem in item.mannschaften %}
                              {% block listitem_mannschaften_mannschaft %}<li>{{ subitem|raw }}</li>{% endblock %}
                          {% endfor %}
                      </ul>
                  {% endblock %}
              {%  endblock %}
          {% endfor %}
          </ul>
          {%  endblock %}
      {% endif %}

  {% endif %}

{% endblock %}

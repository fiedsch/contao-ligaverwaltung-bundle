{
  "name": "fiedsch/ligaverwaltung-bundle",
  "type": "contao-bundle",
  "description": "Contao Bundle: Ligaverwaltung",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Fieger",
      "email": "dev@andreas-fieger.de",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "contao/core-bundle": "^5.7",
    "eluceo/ical": "^2.11",
    "fiedsch/contao-jsonwidget": "^0.8",
    "symfony/string": "^7.0",
    "doctrine/dbal": "^4.4"
  },
  "autoload": {
    "psr-4": {
      "Fiedsch\\Ligaverwaltung\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Fiedsch\\Ligaverwaltung\\ContaoManager\\Plugin",
    "branch-alias": {
      "dev-master": "3.0.x-dev"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^2.13"
  }
}
